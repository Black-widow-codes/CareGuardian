generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(NURSE)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Patient {
  id                         Int      @id @default(autoincrement())

  // Patient identity
  mrn                        String?  @unique
  firstName                  String?
  middleName                 String?
  lastName                   String?
  preferredName              String?

  // Temporary legacy field.
  // Keep until existing patient records are migrated.
  name                       String

  // Demographics
  dob                        String
  sexAtBirth                 String?
  genderIdentity             String?
  pronouns                   String?

  // Current clinical/discharge information
  diagnosis                  String
  dischargeDate              String
  medicationReconciled       Boolean
  followUpScheduled          Boolean
  pendingTests               Boolean
  providerAssigned           Boolean
  dischargeInstructionsGiven Boolean
  homeCareReferral           Boolean
  issue                      String
  score                      Int
  risk                       String

  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

enum UserRole {
  ADMIN
  DISCHARGE_COORDINATOR
  NURSE
  PATIENT_SAFETY_OFFICER
}
